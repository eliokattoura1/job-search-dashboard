# Copy to .streamlit/secrets.toml and fill in the real value.
# secrets.toml itself is gitignored; only this .example is tracked.
#
# On Streamlit Community Cloud there is no file to copy — paste the same
# key/value into the app's Settings -> Secrets box, which is exposed to the
# app as st.secrets exactly like a local file.
#
# USE THE SESSION POOLER URL, NOT THE DIRECT CONNECTION.
# (aws-1-<region>.pooler.supabase.com on port 5432.) Direct connections are
# IPv4-limited on Supabase's free tier and are not reachable from Streamlit
# Community Cloud's runners at all. Port 6543 on the same host is the
# TRANSACTION pooler — this dashboard is read-only so it would survive that,
# but keeping every consumer of the database on one endpoint avoids
# surprises.
#
# Grab it from: Supabase dashboard -> Project Settings -> Database ->
# Connection string -> "Session pooler".

SUPABASE_DB_URL = "postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"
